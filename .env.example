# ClickHouse (Contoso retail dataset)
CLICKHOUSE_HOST=clickhouse.vanya.cc
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=readonly
CLICKHOUSE_PASSWORD=replace-with-your-password
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

# PostgreSQL port (infra/contoso-pg/compose.yaml) — used by --engine postgres
PG_ADMIN_DSN=postgresql://admin:admin@127.0.0.1:5433/contoso
PG_MARKETING_DSN=postgresql://marketing:marketing@127.0.0.1:5433/contoso
# Open WebUI (agentic runner). API key of an admin user (Settings > Account > API keys).
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=replace-with-your-key
OPENWEBUI_RUN_SQL_ADMIN_TOOL_ID=run_sql_admin
OPENWEBUI_RUN_SQL_MARKETING_TOOL_ID=run_sql_marketing
# DSN as seen from the Open WebUI container (written into each tool's PG_DSN valve)
OPENWEBUI_PG_ADMIN_DSN=postgresql://admin:admin@contoso-pg:5432/contoso
OPENWEBUI_PG_MARKETING_DSN=postgresql://marketing:marketing@contoso-pg:5432/contoso
