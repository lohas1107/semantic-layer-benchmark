# ClickHouse (Contoso retail dataset)
CLICKHOUSE_HOST=clickhouse.vanya.cc
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=readonly
CLICKHOUSE_PASSWORD=replace-with-your-password
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

# PostgreSQL port (docker/contoso/compose.yaml) — used by --engine postgres and the Open WebUI runner
PG_DSN=postgresql://bench_ro:bench_ro@127.0.0.1:5433/contoso
# Open WebUI (agentic runner). API key of an admin user (Settings > Account > API keys).
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=replace-with-your-key
OPENWEBUI_RUN_SQL_TOOL_ID=run_sql
# DSN as seen from the Open WebUI container (written into the tool's valve)
OPENWEBUI_PG_DSN=postgresql://bench_ro:bench_ro@contoso-pg:5432/contoso
